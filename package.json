{
  "name": "ia-skills-para-nao-devs",
  "version": "1.0.0",
  "description": "Skills em português (padrão Agent Skills) que fazem qualquer agente de IA programar com as boas práticas de mercado: segurança, governança, CI/CD, documentação e qualidade. Inclui servidor MCP somente leitura.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ia-skills-para-nao-devs": "mcp/servidor.mjs"
  },
  "files": [
    "mcp/",
    "ferramentas/lib/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validar": "node ferramentas/validar-skills.mjs",
    "test": "node --test",
    "verificar:segredos": "node skills/segredos-e-credenciais/scripts/verificar-segredos.mjs",
    "mcp": "node mcp/servidor.mjs",
    "conferir:versoes": "node ferramentas/conferir-versoes.mjs",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-exclude=\"testes/**\" --test-coverage-lines=87 --test-coverage-branches=77 --test-coverage-functions=88",
    "avaliar:gatilhos": "node ferramentas/avaliar-gatilhos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbolsoni/IA-skills-para-nao-devs.git"
  },
  "homepage": "https://github.com/rbolsoni/IA-skills-para-nao-devs#readme",
  "bugs": {
    "url": "https://github.com/rbolsoni/IA-skills-para-nao-devs/issues"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "mcp",
    "boas-praticas",
    "seguranca",
    "ci-cd",
    "lgpd",
    "pt-br"
  ]
}
